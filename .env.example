# ==========================================
# 預約系統 - 環境變數範本
# ==========================================
# 使用方式：
#   1. 複製此檔為 .env.local  (本機開發)
#   2. 複製此檔為 .env        (production / Vercel)
#   3. 把下方預設值改成你的真實值
#
# ⚠️  絕對不要把 .env / .env.local commit 進 git
#    （請確認 .gitignore 有列 .env*，但保留 .env.example）

# ==========================================
# Server-only 變數（不會送到前端，含敏感密鑰）
# ==========================================

# 後台登入密碼（/admin 頁面登入用，自己設一個強密碼）
ADMIN_PASSWORD=

# Supabase 服務角色金鑰（bypass RLS，絕對不能公開）
# 取得：Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot Token（從 @BotFather 拿）
TELEGRAM_BOT_TOKEN=

# Telegram Webhook 驗證 secret token
# 設定：@BotFather → /setwebhook → 輸入自訂 secret 後填到這裡
TELEGRAM_SECRET=

# Admin 的 Telegram User ID（會收到新預約/黑名單通知）
# 取得：跟 @userinfobot 對話，或自己傳訊息後看 update 裡的 from.id
TELEGRAM_ADMIN_ID=


# ==========================================
# Client + Server 變數（NEXT_PUBLIC_* 開頭，會送到前端 bundle）
# ==========================================

# --- Supabase（前端會用到）---
# 取得：Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Telegram（前端深層連結 /login 用）---
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- 部署網址（OAuth callback / email link 用）---
# 本機開發：http://localhost:3000
# Production：你的 Vercel 網址
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 商家資訊（顯示在首頁）---
NEXT_PUBLIC_BUSINESS_NAME=🌿 身心靈預約
NEXT_PUBLIC_BUSINESS_DESC=專業按摩・美容服務

# --- 主題色（CSS variables，可改成你的品牌色）---
NEXT_PUBLIC_COLOR_PRIMARY=#8B7355
NEXT_PUBLIC_COLOR_SECONDARY=#C4A77D
NEXT_PUBLIC_COLOR_ACCENT=#E8D5B7
NEXT_PUBLIC_COLOR_BACKGROUND=#FDF8F3
NEXT_PUBLIC_COLOR_TEXT=#4A4039
NEXT_PUBLIC_COLOR_SUCCESS=#7D9B76

# --- 班別時段（HH:MM 24h 制；夜班可跨夜，NIGHT_END 06:00 表示結束在隔天早上 6 點）---
NEXT_PUBLIC_SHIFT_MORNING_START=06:00
NEXT_PUBLIC_SHIFT_MORNING_END=14:00
NEXT_PUBLIC_SHIFT_AFTERNOON_START=14:00
NEXT_PUBLIC_SHIFT_AFTERNOON_END=22:00
NEXT_PUBLIC_SHIFT_NIGHT_START=22:00
NEXT_PUBLIC_SHIFT_NIGHT_END=06:00
